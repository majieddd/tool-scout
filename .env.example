# =============================================================================
# Tool Scout — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values from PREFLIGHT_SETUP.md Part 4.
# .env is in .gitignore — never commit it.
# =============================================================================

# ----- Crawler -----
# GitHub PAT with public_repo scope only (Token A from PREFLIGHT §2.1)
GITHUB_TOKEN=

# ----- Sheets (Google Cloud service account) -----
# Path to the JSON key downloaded in PREFLIGHT §2.4
GOOGLE_SERVICE_ACCOUNT_PATH=C:\Users\Majied\.tool-scout\gcp-credentials.json
# Drive folder ID where monthly workbooks will be created (PREFLIGHT §2.4)
GOOGLE_DRIVE_FOLDER_ID=

# ----- Git publisher (bot identity for committing crawl data) -----
# Repo clone URL (PREFLIGHT §2.1)
GIT_REPO_URL=https://github.com/Majied/tool-scout.git
# Bot identity — labels only, can be anything
GIT_BOT_USERNAME=tool-scout-bot
GIT_BOT_EMAIL=bot@tool-scout.invalid
# Fine-grained PAT with contents:write on the tool-scout repo only (Token B from PREFLIGHT §2.1)
GIT_BOT_TOKEN=

# ----- ngrok -----
# Auth token from ngrok dashboard (PREFLIGHT §2.3)
NGROK_AUTHTOKEN=
# Static domain reserved on the free plan (PREFLIGHT §2.3)
# Free plan domains end in .ngrok-free.app
NGROK_STATIC_DOMAIN=

# ----- Webhook (between Vercel API and local orchestrator) -----
# Generated automatically by `scout doctor` on first run.
# Don't fill this in manually — let scout doctor generate a 32-byte hex secret.
WEBHOOK_SHARED_SECRET=
# Local FastAPI receiver port (forwarded by ngrok)
WEBHOOK_LOCAL_PORT=8765

# ----- reCAPTCHA v3 (also configure these in Vercel project env vars) -----
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ----- Vercel -----
# Deploy hook URL from Vercel project settings (PREFLIGHT §2.2)
VERCEL_DEPLOY_HOOK_URL=

# ----- Tunables (sensible defaults; only override if you know why) -----
LOG_LEVEL=INFO
CLAUDE_BINARY_PATH=claude

# Soft caps to stay inside Max subscription limits
MAX_CLAUDE_CALLS_PER_5H=40
MAX_CLAUDE_CALLS_PER_DAY=120

# Public wrapper-request rate limits (also enforced via Vercel Edge Config)
RATE_LIMIT_PER_IP_PER_DAY=3
RATE_LIMIT_GLOBAL_PER_DAY=10

# Orchestrator status surface (read-only, localhost-bound — not exposed via ngrok)
ORCHESTRATOR_STATUS_PORT=8766

# ----- Optional -----
REDDIT_USER_AGENT=tool-scout/0.1 (+https://github.com/Majied/tool-scout)
