{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ${CLAUDE_PROJECT_DIR}/.claude/hooks/check-git-staleness.ps1",
            "timeout": 10,
            "statusMessage": "Checking git staleness vs origin..."
          }
        ]
      }
    ]
  }
}
